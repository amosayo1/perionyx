apiVersion: v1
kind: Secret
metadata:
  name: perionyx-secrets
  namespace: perionyx
type: Opaque
stringData:
  # ── Copy this file to app-secrets.yaml and fill in real values. ──
  #    app-secrets.yaml is gitignored and must never be committed.
  #
  # Usage:
  #   cp app-secrets.yaml.example app-secrets.yaml
  #   # Edit app-secrets.yaml with real secrets
  #   kubectl apply -f app-secrets.yaml
  #
  # For production, prefer external secret managers (AWS Secrets Manager,
  # GCP Secret Manager, Vault) over static Kubernetes secrets.

  # Required — PostgreSQL connection string
  DATABASE_URL: "postgresql://user:password@host:5432/perionyx"

  # Required — Redis
  REDIS_HOST: "perionyx-redis"
  REDIS_PASSWORD: "CHANGE_ME"

  # Required — 64-char hex string (openssl rand -hex 32)
  JWT_SECRET: "CHANGE_ME"

  # Required — 32-char string (openssl rand -base64 32)
  ENCRYPTION_KEY: "CHANGE_ME"

  # Required — 64-char hex string (openssl rand -hex 32)
  NEXTAUTH_SECRET: "CHANGE_ME"

  # Optional — Plaid integration
  PLAID_CLIENT_ID: ""
  PLAID_SECRET: ""

  # Optional — Stripe integration
  STRIPE_SECRET_KEY: ""

  # Optional — SMTP for email notifications
  SMTP_PASSWORD: ""
