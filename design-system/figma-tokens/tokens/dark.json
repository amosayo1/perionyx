{
  "surface": {
    "base": { "value": "#0a0a0f", "type": "color", "description": "App background — deepest layer" },
    "raised": { "value": "#111118", "type": "color", "description": "Card/panel surface" },
    "elevated": { "value": "#1a1a24", "type": "color", "description": "Dropdowns, popovers" },
    "floating": { "value": "#222230", "type": "color", "description": "Modals, dialogs" },
    "overlay": { "value": "rgba(0, 0, 0, 0.6)", "type": "color" },
    "sidebar": { "value": "#0a0a0f", "type": "color" },
    "header": { "value": "#0a0a0f", "type": "color" },
    "skeleton": { "value": "#1a1a24", "type": "color" }
  },
  "text": {
    "primary": { "value": "#f7f6f2", "type": "color", "description": "Highest emphasis, ratio 16.5:1 on surface.base ✓ AA" },
    "secondary": { "value": "#a1a1aa", "type": "color", "description": "Body, descriptions — ratio 8.5:1 on base ✓ AA" },
    "tertiary": { "value": "#71717a", "type": "color", "description": "Placeholders, metadata — ratio 5.5:1 on base ✓ AA" },
    "disabled": { "value": "#52525b", "type": "color", "description": "Disabled text — ratio 3.8:1, meets exempt criteria" },
    "inverse": { "value": "#0a0a0f", "type": "color", "description": "Text on brand/light backgrounds" },
    "link": { "value": "#5e9eff", "type": "color" },
    "link-hover": { "value": "#7db1ff", "type": "color" },
    "link-visited": { "value": "#a78bfa", "type": "color" },
    "on-gold": { "value": "#0a0a0f", "type": "color" },
    "on-success": { "value": "#0a0a0f", "type": "color" },
    "on-error": { "value": "#ffffff", "type": "color" }
  },
  "border": {
    "default": { "value": "rgba(255, 255, 255, 0.08)", "type": "color" },
    "strong": { "value": "rgba(255, 255, 255, 0.12)", "type": "color" },
    "subtle": { "value": "rgba(255, 255, 255, 0.04)", "type": "color" },
    "gold": { "value": "rgba(212, 175, 55, 0.2)", "type": "color" },
    "focus": { "value": "rgba(212, 175, 55, 0.5)", "type": "color" },
    "hover": { "value": "rgba(255, 255, 255, 0.12)", "type": "color" }
  },
  "shadow-soft": { "value": "0px 1px 3px 0px rgba(0,0,0,0.30)", "type": "boxShadow" },
  "shadow-medium": { "value": "0px 4px 12px 0px rgba(0,0,0,0.40)", "type": "boxShadow" },
  "shadow-large": { "value": "0px 8px 24px 0px rgba(0,0,0,0.50)", "type": "boxShadow" },
  "shadow-floating": { "value": "0px 12px 40px 0px rgba(0,0,0,0.50)", "type": "boxShadow" },
  "shadow-glow-gold": { "value": "0px 0px 20px 0px rgba(212,175,55,0.15)", "type": "boxShadow" },
  "shadow-glow-success": { "value": "0px 0px 20px 0px rgba(34,197,94,0.15)", "type": "boxShadow" },
  "shadow-glow-danger": { "value": "0px 0px 20px 0px rgba(239,68,68,0.15)", "type": "boxShadow" },
  "shadow-glow-info": { "value": "0px 0px 20px 0px rgba(59,130,246,0.15)", "type": "boxShadow" },
  "elevation": {
    "base": { "value": "{surface.base}", "type": "color", "$extensions": { "shadow": "none", "border": "{border.subtle}" } },
    "raised": { "value": "{surface.raised}", "type": "color", "$extensions": { "shadow": "{shadow-base.soft}", "border": "{border.default}" } },
    "elevated": { "value": "{surface.elevated}", "type": "color", "$extensions": { "shadow": "{shadow-base.medium}", "border": "{border.default}" } },
    "floating": { "value": "{surface.floating}", "type": "color", "$extensions": { "shadow": "{shadow-base.large}", "border": "{border.strong}" } },
    "hover": { "value": "{surface.elevated}", "type": "color", "$extensions": { "shadow": "{shadow-base.medium}", "border": "{border.hover}" } },
    "selected": { "value": "{surface.raised}", "type": "color", "$extensions": { "shadow": "{shadow-base.glow-gold}", "border": "{border.gold}" } }
  },
  "component": {
    "button": {
      "primary": { "bg": "{brand.gold}", "bg-hover": "{brand.gold-hover}", "bg-active": "{brand.gold-active}", "text": "{text.inverse}", "shadow": "none" },
      "primary-large": { "bg": "{brand.gold}", "bg-hover": "{brand.gold-hover}", "text": "{text.inverse}", "radius": "{border-radius.lg}" },
      "primary-small": { "bg": "{brand.gold}", "bg-hover": "{brand.gold-hover}", "text": "{text.inverse}", "radius": "{border-radius.sm}" },
      "secondary": { "bg": "transparent", "bg-hover": "{surface.elevated}", "bg-active": "{surface.floating}", "text": "{text.primary}", "border": "{border.default}", "border-hover": "{border.strong}" },
      "ghost": { "bg": "transparent", "bg-hover": "{surface.elevated}", "bg-active": "{surface.floating}", "text": "{text.secondary}" },
      "danger": { "bg": "{status.error}", "bg-hover": "{status.error-hover}", "bg-active": "#b91c1c", "text": "#ffffff" },
      "icon": { "bg": "transparent", "bg-hover": "{surface.elevated}", "text": "{text.secondary}" },
      "disabled": { "bg": "{surface.elevated}", "text": "{text.disabled}", "border": "{border.subtle}" }
    },
    "card": {
      "default": { "bg": "{surface.raised}", "border": "{border.default}", "shadow": "{shadow-base.soft}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}" },
      "elevated": { "bg": "{surface.elevated}", "border": "{border.default}", "shadow": "{shadow-base.medium}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}" },
      "interactive": { "bg": "{surface.raised}", "border": "{border.default}", "shadow": "{shadow-base.soft}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}", "transition": "all 200ms cubic-bezier(0.4, 0, 0.2, 1)" },
      "metric": { "bg": "{surface.raised}", "border": "{border.default}", "shadow": "{shadow-base.soft}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}", "accent": "3px solid {brand.gold}" },
      "selected": { "bg": "{surface.raised}", "border": "{border.gold}", "shadow": "{shadow-base.glow-gold}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}" },
      "decision": { "bg": "{surface.raised}", "border": "{border.default}", "shadow": "{shadow-base.medium}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}", "accent": "3px solid {brand.gold}" },
      "evidence": { "bg": "{surface.raised}", "border": "{border.default}", "shadow": "{shadow-base.soft}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}" },
      "exception": { "bg": "{surface.raised}", "border-left": "4px solid {status.error}", "shadow": "{shadow-base.soft}", "radius": "{border-radius.card}", "padding": "{layout-semantic.card-padding}" }
    },
    "input": {
      "default": { "bg": "{surface.base}", "border": "{border.default}", "text": "{text.primary}", "placeholder": "{text.tertiary}", "radius": "{border-radius.control}" },
      "hover": { "bg": "{surface.base}", "border": "{border.hover}", "text": "{text.primary}", "radius": "{border-radius.control}" },
      "focus": { "bg": "{surface.base}", "border": "{border.gold}", "text": "{text.primary}", "radius": "{border-radius.control}", "shadow": "0px 0px 0px 1px {brand.gold-focus}" },
      "error": { "bg": "{surface.base}", "border": "{status.error-border}", "text": "{text.primary}", "radius": "{border-radius.control}", "shadow": "0px 0px 0px 1px {status.error-border}" },
      "success": { "bg": "{surface.base}", "border": "{status.success-border}", "text": "{text.primary}", "radius": "{border-radius.control}" },
      "disabled": { "bg": "{surface.elevated}", "border": "{border.subtle}", "text": "{text.disabled}", "radius": "{border-radius.control}" },
      "search": { "bg": "{surface.base}", "border": "{border.default}", "text": "{text.primary}", "placeholder": "{text.tertiary}", "radius": "{border-radius.full}", "icon": "{text.tertiary}" }
    },
    "badge": {
      "default": { "bg": "{surface.elevated}", "text": "{text.secondary}", "border": "{border.default}" },
      "gold": { "bg": "{brand.gold-muted}", "text": "{brand.gold}", "border": "{brand.gold-border}" },
      "success": { "bg": "{status.success-muted}", "text": "{status.success}", "border": "{status.success-border}" },
      "warning": { "bg": "{status.warning-muted}", "text": "{status.warning}", "border": "{status.warning-border}" },
      "error": { "bg": "{status.error-muted}", "text": "{status.error}", "border": "{status.error-border}" },
      "info": { "bg": "{status.info-muted}", "text": "{status.info}", "border": "{status.info-border}" }
    },
    "table": {
      "header-bg": { "value": "{surface.raised}", "type": "color" },
      "header-text": { "value": "{text.secondary}", "type": "color" },
      "header-border": { "value": "{border.default}", "type": "color" },
      "row-bg": { "value": "transparent", "type": "color" },
      "row-hover": { "value": "rgba(255, 255, 255, 0.03)", "type": "color" },
      "row-selected": { "value": "{brand.gold-subtle}", "type": "color" },
      "row-border": { "value": "{border.subtle}", "type": "color" },
      "cell-text": { "value": "{text.primary}", "type": "color" },
      "cell-text-secondary": { "value": "{text.secondary}", "type": "color" }
    },
    "dialog": {
      "backdrop": { "value": "{surface.overlay}", "type": "color" },
      "bg": { "value": "{surface.raised}", "type": "color" },
      "border": { "value": "{border.strong}", "type": "color" },
      "shadow": { "value": "{shadow-base.floating}", "type": "boxShadow" },
      "header-text": { "value": "{text.primary}", "type": "color" },
      "body-text": { "value": "{text.secondary}", "type": "color" }
    },
    "toast": {
      "bg": { "value": "{surface.raised}", "type": "color" },
      "success-border": { "value": "{status.success-border}", "type": "color" },
      "error-border": { "value": "{status.error-border}", "type": "color" },
      "warning-border": { "value": "{status.warning-border}", "type": "color" },
      "info-border": { "value": "{status.info-border}", "type": "color" }
    },
    "tooltip": {
      "bg": { "value": "{surface.floating}", "type": "color" },
      "text": { "value": "{text.primary}", "type": "color" },
      "border": { "value": "{border.strong}", "type": "color" }
    },
    "skeleton": {
      "bg": { "value": "{surface.skeleton}", "type": "color" },
      "shimmer": { "value": "rgba(255, 255, 255, 0.04)", "type": "color" }
    },
    "sidebar": {
      "bg": { "value": "{surface.base}", "type": "color" },
      "item-text": { "value": "{text.secondary}", "type": "color" },
      "item-hover": { "value": "{surface.elevated}", "type": "color" },
      "item-active": { "value": "{brand.gold-subtle}", "type": "color" },
      "item-active-text": { "value": "{brand.gold}", "type": "color" },
      "item-active-indicator": { "value": "{brand.gold}", "type": "color" },
      "group-label": { "value": "{text.tertiary}", "type": "color" },
      "divider": { "value": "{border.subtle}", "type": "color" }
    },
    "topbar": {
      "bg": { "value": "{surface.base}", "type": "color" },
      "border": { "value": "{border.default}", "type": "color" },
      "icon": { "value": "{text.secondary}", "type": "color" },
      "icon-hover": { "value": "{text.primary}", "type": "color" }
    },
    "nav-tab": {
      "default-text": { "value": "{text.secondary}", "type": "color" },
      "active-text": { "value": "{brand.gold}", "type": "color" },
      "active-indicator": { "value": "{brand.gold}", "type": "color" },
      "hover-bg": { "value": "{surface.elevated}", "type": "color" }
    },
    "ai-card": {
      "bg": { "value": "{surface.raised}", "type": "color" },
      "accent": { "value": "{brand.gold}", "type": "color" },
      "badge-bg": { "value": "{brand.gold-muted}", "type": "color" },
      "badge-text": { "value": "{brand.gold}", "type": "color" }
    },
    "status-chip": {
      "pending-bg": { "value": "{status.warning-muted}", "type": "color" },
      "pending-text": { "value": "{status.warning}", "type": "color" },
      "completed-bg": { "value": "{status.success-muted}", "type": "color" },
      "completed-text": { "value": "{status.success}", "type": "color" },
      "failed-bg": { "value": "{status.error-muted}", "type": "color" },
      "failed-text": { "value": "{status.error}", "type": "color" },
      "draft-bg": { "value": "{surface.elevated}", "type": "color" },
      "draft-text": { "value": "{text.tertiary}", "type": "color" }
    }
  }
}
