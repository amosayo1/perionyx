# =============================================================================
# Perionyx — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# CRITICAL: Never commit .env to version control. It is gitignored.
# Generate secrets using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# -- Database -----------------------------------------------------------------
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/perionyx?schema=public"

# -- Redis --------------------------------------------------------------------
# Redis connection string (required for distributed rate limiting, caching, queues)
REDIS_URL="redis://localhost:6379"

# -- Authentication -----------------------------------------------------------
# NextAuth secret — generate: openssl rand -base64 32 (required)
AUTH_SECRET=""
# NextAuth URL (required in production)
NEXTAUTH_URL="http://localhost:3000"

# JWT secret — generate: openssl rand -base64 32 (required, min 32 chars)
JWT_SECRET=""

# -- Encryption ---------------------------------------------------------------
# Master encryption key — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). This is REQUIRED — no fallback.
ENCRYPTION_KEY=""
# Encryption key version identifier. Change when rotating keys.
# Format: v1, v2, etc. Used to track which key encrypted each payload.
ENCRYPTION_KEY_ID="v1"
# Optional: Previous encryption keys for seamless rotation (comma-separated key_id=hex_key)
# ENCRYPTION_KEY_HISTORY="v0=abcdef...1234"

# -- Application --------------------------------------------------------------
# Node environment (development | production | test)
NODE_ENV="development"
# Canonical application URL (required)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Application version (set automatically during build)
NEXT_PUBLIC_APP_VERSION="1.0.0"

# -- Monitoring & Error Tracking ----------------------------------------------
# Sentry DSN (recommended in production, optional in development)
# SENTRY_DSN="https://key@oXX.ingest.sentry.io/project"

# -- Logging ------------------------------------------------------------------
# Log level: trace | debug | info | warn | error | fatal
# Default: info in production, debug in development
# LOG_LEVEL="info"

# -- SMTP / Email -------------------------------------------------------------
# SMTP server for email notifications (optional — logs to console when absent)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@perionyx.io"

# -- Plaid (Banking Connector) ------------------------------------------------
# Optional — mock mode used when absent
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"

# -- QuickBooks Online (ERP Connector) ----------------------------------------
# Optional — 'Not Configured' state shown when absent
# QB_CLIENT_ID=""
# QB_CLIENT_SECRET=""
# QB_ENV="sandbox"
# QB_REDIRECT_URI="http://localhost:3000/api/v1/integrations/connectors/qbo/callback"
# QB_WEBHOOK_TOKEN=""

# -- AI Providers -------------------------------------------------------------
# AI Copilot API key (OpenAI-compatible)
# AI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# -- Slack Notifications ------------------------------------------------------
# Slack webhook URL for notifications (optional)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/..."

# -- Push Notifications (PWA) -------------------------------------------------
# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@perionyx.io"

# -- FX / Currency Rates ------------------------------------------------------
# Exchange rate provider API key (optional)
# FX_API_KEY=""

# -- License Enforcement ------------------------------------------------------
# Set to a company ID to lock deployment to single-tenant mode.
# Leave unset for multi-tenant (unlicensed / dev mode).
# LICENSE_COMPANY_ID="company_abc123"

# HMAC-SHA256 secret for license key signing.
# Generate: openssl rand -hex 32
# LICENSE_SECRET=""

# -- Cron / Background Jobs ---------------------------------------------------
# Secret to protect cron endpoints like /api/v1/tick from public access
# CRON_SECRET=""

# -- Seed Data (Development Only) ---------------------------------------------
# SEED_USER_EMAIL="admin@perionyx.local"
# SEED_USER_PASSWORD="password12345"
# SEED_COMPANY_SLUG="demo-company"
