# PostgreSQL (required for Prisma + runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Redis (required for rate limiting across multi-instance deployments)
# REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Sentry DSN for error monitoring (recommended in production — no-ops when absent)
# SENTRY_DSN="https://key@oXX.ingest.sentry.io/project"

# Log level: trace, debug, info, warn, error, fatal (default: info in production, debug in dev)
# LOG_LEVEL="info"

# Optional: canonical app URL (recommended in production)
# NEXTAUTH_URL="https://app.example.com"
# AUTH_URL="https://app.example.com"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Plaid (optional — mock mode used when absent)
# PLAID_CLIENT_ID="..."
# PLAID_SECRET="..."
# PLAID_ENV="sandbox"

# QuickBooks Online (optional — 'Not Configured' state shown when absent)
# QB_CLIENT_ID="..."
# QB_CLIENT_SECRET="..."
# QB_ENV="sandbox"
# QB_REDIRECT_URI="http://localhost:3000/api/v1/integrations/connectors/qbo/callback"
# QB_WEBHOOK_TOKEN="..."

# SMTP for email notifications (optional — logs to console when absent)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="..."
# SMTP_PASS="..."
# SMTP_FROM="noreply@perionyx.dev"

# Slack webhook notifications (optional)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/..."

# Encryption key — generate with: openssl rand -hex 32 (required)
# ENCRYPTION_KEY="replace-with-a-64-char-hex-string"

# License enforcement: set to the company ID to lock this deployment to one company.
# All requests with a different active company will be rejected with 403.
# Leave unset to allow multiple companies (unlicensed / dev mode).
# LICENSE_COMPANY_ID="company_abc123"

# Secret used to sign license keys (HMAC-SHA256). Required for multi-license mode.
# Generate with: openssl rand -hex 32
# LICENSE_SECRET="change-me-to-a-random-64-char-hex-string"

# Cron job secret — protects /api/v1/tick from public access
# CRON_SECRET="change-me-to-a-random-value"

# Used by prisma/seed.ts (optional overrides)
# SEED_USER_EMAIL="founder@demo.vaulta.local"
# SEED_USER_PASSWORD="password12345"
# SEED_COMPANY_SLUG="demo-company"
