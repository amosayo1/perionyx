// Perionyx — PostgreSQL. Financial rules are enforced in services; not every rule is a DB constraint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  /// Bcrypt for credentials sign-in; null for OAuth-only users.
  passwordHash        String?   @map("password_hash")
  /// Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Session versioning — increment to invalidate all active JWT sessions
  tokenVersion        Int       @default(1)

  /// MFA (Multi-Factor Authentication)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret")
  mfaRecoveryCodes    String?   @map("mfa_recovery_codes")  // JSON array of hashed recovery codes
  mfaEnrolledAt       DateTime? @map("mfa_enrolled_at")
  mfaLastVerifiedAt   DateTime? @map("mfa_last_verified_at")
  mfaRequired         Boolean   @default(false) @map("mfa_required")  // org-level enforcement

  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]

  /// At least one membership is required for normal product flows.
  memberships          CompanyMembership[]
  auditLogs            AuditLog[]          @relation("AuditActor")
  transactionsCreated  Transaction[]       @relation("TransactionCreatedBy")
  userRoles            UserRole[]
  approvalRulesCreated ApprovalRule[]      @relation("ApprovalRuleCreatedBy")
  approvalRulesUpdated ApprovalRule[]      @relation("ApprovalRuleUpdatedBy")

  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  invitationsSent         Invitation[]             @relation("InvitedBy")
  approvalComments        ApprovalComment[]        @relation("CommentAuthor")
  approvalParticipants    ApprovalParticipant[]    @relation("ParticipantUser")
  objectVersions          ObjectVersion[]          @relation("ObjectVersionAuthor")

  automationTemplatesCreated AutomationTemplate[]     @relation("AutomationTemplateCreatedBy")
  automationTemplatesUpdated AutomationTemplate[]     @relation("AutomationTemplateUpdatedBy")
  approvalMatrixRulesCreated ApprovalMatrixRule[]     @relation("ApprovalMatrixRuleCreatedBy")
  approvalMatrixRulesUpdated ApprovalMatrixRule[]     @relation("ApprovalMatrixRuleUpdatedBy")
  businessRulesCreated       BusinessRuleDefinition[] @relation("BusinessRuleDefinitionCreatedBy")
  businessRulesUpdated       BusinessRuleDefinition[] @relation("BusinessRuleDefinitionUpdatedBy")
  automationSchedulesCreated AutomationSchedule[]     @relation("AutomationScheduleCreatedBy")
  automationSchedulesUpdated AutomationSchedule[]     @relation("AutomationScheduleUpdatedBy")
  userPreferences            UserPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
}

