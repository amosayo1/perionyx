  status        String    @default("OPEN") /// "OPEN" | "IN_PROGRESS" | "COMPLETED" | "DEFERRED"
  dueDate       DateTime?
  referenceType String? /// "approval" | "workflow" | "briefing" | "scenario"
  referenceId   String?
