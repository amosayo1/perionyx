model ExecutiveBriefing {
  id           String   @id @default(cuid())
  companyId    String
  briefingDate DateTime @default(now())
  period       String /// "daily" | "weekly" | "monthly"
  status       String   @default("GENERATED") /// "GENERATING" | "GENERATED" | "DELIVERED" | "FAILED"

  cashPosition         Json   @default("{}")
  liquidity            Json   @default("{}")
  workingCapital       Json   @default("{}")
  revenueTrends        Json   @default("{}")
  expenseTrends        Json   @default("{}")
  treasuryHealth       Json   @default("{}")
  financialIntegrity   Json   @default("{}")
  closeReadiness       Json   @default("{}")
  complianceHealth     Json   @default("{}")
  operationalRisks     Json   @default("[]")
  significantAnomalies Json   @default("[]")
  criticalAlerts       Json   @default("[]")
  openApprovals        Json   @default("[]")
  recommendedActions   Json   @default("[]")
