// Phase 13.2 — Enterprise Reconciliation Platform
// ─────────────────────────────────────────────────────────────

model ReconciliationCase {
  id                 String    @id @default(cuid())
  companyId          String
  title              String
  reconciliationType String /// "bank" | "gl" | "subledger" | "intercompany" | "ar" | "ap" | "fixed_asset" | "treasury" | "payroll" | "tax" | "multi_company" | "multi_currency"
  status             String    @default("OPEN") /// "OPEN" | "IN_PROGRESS" | "MATCHED" | "PARTIALLY_MATCHED" | "EXCEPTION" | "CLOSED" | "ESCALATED"
  period             String /// "2026-01" | "2026-02"
  entityName         String?
  currency           String    @default("USD")
  totalDebit         Decimal   @default(0) @db.Decimal(19, 4)
  totalCredit        Decimal   @default(0) @db.Decimal(19, 4)
  matchedCount       Int       @default(0)
  unmatchedCount     Int       @default(0)
  exceptionCount     Int       @default(0)
  matchRate          Decimal   @default(0) @db.Decimal(5, 4) /// 0.0000 to 1.0000
  readinessScore     Decimal   @default(0) @db.Decimal(5, 4)
  assignedTo         String?
  dueDate            DateTime?
  closedAt           DateTime?
  metadata           Json      @default("{}")

  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  exceptions          ReconException[]
  matchingExecutions  MatchingExecution[]
  matchingSuggestions MatchingSuggestion[]
  evidence            ReconciliationEvidence[]
  investigations      InvestigationTimeline[]
  journalSuggestions  JournalSuggestion[]
  assignments         ReconciliationAssignment[]
  escalations         ReconciliationEscalation[]
  matchingHistories   MatchingHistory[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([companyId, reconciliationType])
  @@index([companyId, status])
  @@index([companyId, period])
  @@index([companyId, assignedTo])
  @@index([companyId, reconciliationType, period])
  @@map("reconciliation_cases")
}

model ReconException {
  id                 String    @id @default(cuid())
  companyId          String
  caseId             String
  exceptionType      String /// "timing_difference" | "duplicate_payment" | "missing_journal" | "missing_bank_entry" | "wrong_account" | "wrong_currency" | "fx_difference" | "bank_charges" | "interest" | "manual_adjustment" | "data_import_error" | "unknown"
  severity           String    @default("MEDIUM") /// "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  status             String    @default("OPEN") /// "OPEN" | "INVESTIGATING" | "RESOLVED" | "ESCALATED" | "DISMISSED"
  sourceSystem       String /// "bank" | "gl" | "subledger" | "ar" | "ap" | "manual"
  referenceNumber    String?
  description        String
  amount             Decimal   @default(0) @db.Decimal(19, 4)
  currency           String    @default("USD")
  expectedAmount     Decimal?
  varianceAmount     Decimal?  @db.Decimal(19, 4)
  variancePercentage Decimal?  @db.Decimal(5, 4)
  transactionDate    DateTime?
  postedDate         DateTime?
  explanation        Json      @default("{}") /// structured explanation with evidence
  evidence           Json      @default("[]") /// references to supporting evidence
  resolution         Json      @default("{}")
  assignedTo         String?
  resolvedBy         String?
  resolvedAt         DateTime?
  metadata           Json      @default("{}")

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  case               ReconciliationCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  journalSuggestions JournalSuggestion[]
  classifications    ExceptionClassification[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([companyId, caseId])
  @@index([companyId, exceptionType])
  @@index([companyId, severity])
  @@index([companyId, status])
  @@index([companyId, assignedTo])
  @@index([caseId, exceptionType])
  @@map("recon_exceptions")
}

model MatchingRule {
  id                     String  @id @default(cuid())
  companyId              String
  name                   String
  description            String  @default("")
  ruleType               String /// "exact" | "amount" | "reference" | "date_tolerance" | "currency_tolerance" | "percentage_tolerance" | "many_to_one" | "one_to_many" | "many_to_many" | "split" | "merged" | "custom"
  priority               Int     @default(0)
  isActive               Boolean @default(true)
  version                Int     @default(1)
  matchingCriteria       Json    @default("{}") /// field mappings, thresholds, tolerances
  scoringWeights         Json    @default("{}") /// weights for confidence calculation
  maxConfidenceThreshold Decimal @default(0) @db.Decimal(5, 4) /// minimum confidence to auto-match
  autoMatchEnabled       Boolean @default(false)
  metadata               Json    @default("{}")

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executions MatchingExecution[]
  versions   RuleVersion[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId, ruleType])
  @@index([companyId, isActive])
  @@index([companyId, priority])
  @@map("matching_rules")
}

model MatchingExecution {
  id                String  @id @default(cuid())
  companyId         String
  caseId            String
  ruleId            String?
  executionType     String /// "auto" | "manual" | "batch"
  status            String  @default("PENDING") /// "PENDING" | "RUNNING" | "COMPLETED" | "FAILED" | "CANCELLED"
  inputCount        Int     @default(0)
  matchedCount      Int     @default(0)
  unmatchedCount    Int     @default(0)
  averageConfidence Decimal @default(0) @db.Decimal(5, 4)
  executionTimeMs   Int     @default(0)
  results           Json    @default("[]") /// matched pairs with confidence scores
  errors            Json    @default("[]")
  metadata          Json    @default("{}")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  case        ReconciliationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  rule        MatchingRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  suggestions MatchingSuggestion[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([companyId, caseId])
  @@index([companyId, ruleId])
  @@index([companyId, status])
  @@index([caseId, status])
  @@map("matching_executions")
}

model MatchingSuggestion {
  id                   String    @id @default(cuid())
  companyId            String
  caseId               String
  executionId          String?
  suggestionType       String /// "match" | "partial_match" | "split" | "merge" | "reclassify"
  confidence           Decimal   @default(0) @db.Decimal(5, 4)
  sourceTransactionIds Json      @default("[]")
  targetTransactionIds Json      @default("[]")
  sourceTotal          Decimal   @default(0) @db.Decimal(19, 4)
  targetTotal          Decimal   @default(0) @db.Decimal(19, 4)
  variance             Decimal   @default(0) @db.Decimal(19, 4)
  explanation          Json      @default("{}") /// why this match was suggested
  status               String    @default("PENDING") /// "PENDING" | "ACCEPTED" | "REJECTED" | "EXPIRED"
  acceptedBy           String?
  acceptedAt           DateTime?
  metadata             Json      @default("{}")

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  case      ReconciliationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  execution MatchingExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([companyId, caseId])
  @@index([companyId, executionId])
  @@index([companyId, confidence])
  @@index([companyId, status])
  @@index([caseId, status])
  @@map("matching_suggestions")
}

