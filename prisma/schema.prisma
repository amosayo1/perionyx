model FinancialReportDefinition {
  id          String                     @id @default(cuid())
  companyId   String
  name        String
  description String
  reportType  String /// ReportType enum value
  audience    String? /// ReportAudience enum value
  config      Json /// ReportConfig
  isActive    Boolean                    @default(true)
  isTemplate  Boolean                    @default(false)
  version     Int                        @default(1)
  createdBy   String
  lastRunAt   DateTime?
  lastRunById String?
  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executions  FinancialReportExecution[]
  schedules   FinancialReportSchedule[]
  views       FinancialReportSavedView[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([companyId, reportType])
  @@index([companyId, audience])
  @@index([companyId, isActive])
  @@map("financial_report_definitions")
}

model FinancialReportExecution {
  id              String                      @id @default(cuid())
  definitionId    String
  companyId       String
  status          String /// ExecutionStatus enum value
  reportType      String
  config          Json /// ReportConfig snapshot
  sections        Json /// ReportSection[]
  summary         Json? /// AICommentary
  totalRows       Int                         @default(0)
  executionTimeMs Int                         @default(0)
  error           String?
  requestedBy     String
  completedAt     DateTime?
  expiresAt       DateTime?
  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  definition      FinancialReportDefinition?  @relation(fields: [definitionId], references: [id])
  commentaries    FinancialReportCommentary[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([companyId, status])
  @@index([companyId, definitionId])
  @@index([companyId, createdAt])
  @@map("financial_report_executions")
}

model FinancialReportSchedule {
  id             String                     @id @default(cuid())
  definitionId   String
