model Contact {
  id                       String                @id @default(cuid())
  companyId                String?
  name                     String
  role                     String
  company                  String?
  source                   ContactSource         @default(WEBSITE)
  relationshipStage        RelationshipStage     @default(DISCOVERY_CONVERSATION)
  status                   ContactStatus         @default(ACTIVE)
  expertise                String[]
  tags                     String[]
  notes                    String                @default("")
  isStrategicAdvisor       Boolean               @default(false)
  location                 String?
  whatsapp                 String?
  priority                 String?
  region                   String?
  relationshipType         String?
  potentialRoles           String[]
  classification           Classification?
  designPartnerPotential   DesignPartnerPotential?
  productModules           String[]
  conversationSummary      String?
  keyProductInsights       String[]
  preferredLanguage        String?
  industryExperience       String[]
  potentialContributions   String[]
  recommendedNextSteps     String[]
  nextFollowUp             DateTime?
  conversationStatus       String?

  /// Section 1: Relationship Intelligence
  relationshipStrength        Int?                    @map("relationship_strength")
  trustScore                  Int?                    @map("trust_score")
  engagementLevel             String?
  championPotential           Boolean                 @default(false) @map("champion_potential")
  advisorPotential            Boolean                 @default(false) @map("advisor_potential")
  investorPotential           Boolean                 @default(false) @map("investor_potential")
  pilotCustomerPotential      Boolean                 @default(false) @map("pilot_customer_potential")
  referralPotential           Boolean                 @default(false) @map("referral_potential")
  hiringPotential             Boolean                 @default(false) @map("hiring_potential")
  strategicImportance         StrategicImportance?    @map("strategic_importance")
  lastMeaningfulConversation  DateTime?               @map("last_meaningful_conversation")
  nextRecommendedAction       String?                 @map("next_recommended_action")
  relationshipHealth          RelationshipHealth?     @default(HEALTHY) @map("relationship_health")

  professionalProfile     ProfessionalProfile?
  interactions            Interaction[]
  opportunities           Opportunity[]
  tasks                   Task[]
  intelligence            ContactIntelligence?
  insights                VoiceOfCustomerInsight[]
  painPoints              PainPoint[]
  discoverySessions       ProductDiscoverySession[]
  timelineEvents          TimelineEvent[]
  knowledgeGraphAsSource  CrmKnowledgeLink[]       @relation("SourceContact")
  knowledgeGraphAsTarget  CrmKnowledgeLink[]       @relation("TargetContact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([name])
  @@index([relationshipStage])
  @@index([status])
  @@index([priority])
  @@index([region])
  @@index([strategicImportance])
  @@index([relationshipHealth])
  @@map("crm_contacts")
}

model ProfessionalProfile {
