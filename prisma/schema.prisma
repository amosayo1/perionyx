model RoleDashboard {
  id        String   @id @default(cuid())
  companyId String
  role      String /// RoleType enum
  config    Json /// dashboard layout, widgets, KPIs
  isDefault Boolean  @default(false)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, role])
  @@map("role_dashboards")
}

model MorningBriefing {
  id                    String    @id @default(cuid())
  companyId             String
  date                  DateTime  @default(now())
  title                 String?
  summary               String? /// AI-generated narrative summary
  highlights            Json? /// FinancialHighlights
  kpis                  Json? /// key metric snapshots
  pendingApprovals      Int       @default(0)
  pendingApprovalAmount Decimal?  @db.Decimal(20, 4) @map("pending_approval_amount")
  cashPosition          Decimal?  @db.Decimal(20, 4)
  cashChange            Decimal?  @db.Decimal(20, 4) @map("cash_change")
  reconciliationStatus  String? /// "current" | "aging" | "overdue"
  risks                 Json? /// RiskAlert[]
  recommendedActions    Json? /// RecommendedAction[]
  isRead                Boolean   @default(false)
  readAt                DateTime?
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())

  @@index([companyId, date])
  @@map("morning_briefings")
}

model ImplementationMilestone {
  id            String                   @id @default(cuid())
  companyId     String
  slug          String /// milestone identifier
  name          String
  description   String?
  category      String /// "setup" | "integration" | "configuration" | "validation" | "go-live"
  order         Int                      @default(0)
  isRequired    Boolean                  @default(true)
  estimatedDays Int?                     @map("estimated_days")
  dependsOn     String? /// slug of prerequisite milestone
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  progress      ImplementationProgress[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, category])
  @@map("implementation_milestones")
}

model ImplementationProgress {
  id          String                  @id @default(cuid())
  companyId   String
  milestoneId String
  status      String                  @default("pending") /// "pending" | "in_progress" | "completed" | "skipped" | "blocked"
  completedAt DateTime?
  completedBy String?
  notes       String?
  metadata    Json? /// extra progress data
  milestone   ImplementationMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([companyId, milestoneId])
  @@index([companyId, status])
  @@map("implementation_progress")
}

model FeatureFlag {
  id           String   @id @default(cuid())
  companyId    String
  slug         String /// feature identifier
  name         String
  description  String?
  category     String /// "onboarding" | "advanced" | "expert" | "beta"
  requiredRole String? /// minimum role to see
  dependsOn    String? /// prerequisite feature slug
  isEnabled    Boolean  @default(false)
  isBeta       Boolean  @default(false)
  metadata     Json? /// extra config
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, category, isEnabled])
  @@map("feature_flags")
}

model ProductGuidance {
  id           String                 @id @default(cuid())
  companyId    String
  slug         String /// tour identifier
  title        String
  description  String?
  triggerOn    String? /// "page:integration-platform" | "feature:reconciliation" | "first-sync" etc.
  targetRole   String? /// optional role filter
  priority     Int                    @default(0)
  isActive     Boolean                @default(true)
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps        GuidanceStep[]
  userProgress UserGuidanceProgress[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, isActive])
  @@map("product_guidance")
}

model GuidanceStep {
  id            String          @id @default(cuid())
  guidanceId    String
  order         Int
  title         String
  content       String
  targetElement String? /// CSS selector for spotlight
  placement     String          @default("bottom") /// "top" | "bottom" | "left" | "right" | "center"
  mediaUrl      String? /// optional image/video
  actionLabel   String? /// optional CTA button text
  actionUrl     String? /// optional CTA link
  guidance      ProductGuidance @relation(fields: [guidanceId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@unique([guidanceId, order])
  @@index([guidanceId])
  @@map("guidance_steps")
}

model UserGuidanceProgress {
  id          String          @id @default(cuid())
  userId      String
  guidanceId  String
  stepIndex   Int             @default(0)
  isCompleted Boolean         @default(false)
  completedAt DateTime?
  dismissedAt DateTime?
  guidance    ProductGuidance @relation(fields: [guidanceId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, guidanceId])
  @@index([userId, isCompleted])
  @@map("user_guidance_progress")
}

model AdoptionEvent {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  eventType  String /// "page_view" | "feature_use" | "action" | "export" | "sync" | "approval"
  category   String /// "workspace" | "feature" | "integration"
  key        String /// feature/page/action identifier
  label      String? /// human-readable label
  metadata   Json? /// extra context
  durationMs Int?     @map("duration_ms")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, eventType, key])
  @@index([userId])
  @@map("adoption_events")
}

model AdoptionScore {
  id                  String   @id @default(cuid())
  companyId           String
  periodStart         DateTime
  periodEnd           DateTime
  overallScore        Float    @default(0) /// 0-100
  userAdoption        Json? /// per-user adoption rates
  featureUsage        Json? /// per-feature usage counts
  workspaceEngagement Json? /// per-workspace engagement
  activeUsers         Int      @default(0)
  totalUsers          Int      @default(0)
  unusedFeatures      Json? /// feature slugs never used
  recommendations     Json? /// training/action recommendations
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([companyId, periodStart, periodEnd])
  @@map("adoption_scores")
}

model CustomerSuccessResource {
  id          String   @id @default(cuid())
  companyId   String
  type        String /// "documentation" | "tutorial" | "release_note" | "video" | "guide" | "faq"
  title       String
  description String?
  url         String?
  content     String? /// inline markdown content
  tags        Json? /// string[] for search/filter
  roleTarget  String? /// optional target role
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, type, isPublished])
  @@map("customer_success_resources")
}

model FeatureRequest {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  title       String
  description String?
  category    String? /// "integration" | "reporting" | "workflow" | "automation" | "ux" | "other"
  status      String   @default("submitted") /// "submitted" | "under_review" | "planned" | "in_progress" | "shipped" | "declined"
  votes       Int      @default(0)
  isPublic    Boolean  @default(false)
  adminNotes  String?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status])
  @@map("feature_requests")
}

model SupportTicket {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  subject     String
  description String?
  category    String? /// "technical" | "billing" | "account" | "feature" | "bug"
  priority    String   @default("normal") /// "low" | "normal" | "high" | "critical"
  status      String   @default("open") /// "open" | "in_progress" | "waiting" | "resolved" | "closed"
  assignedTo  String?
  resolution  String?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status, priority])
  @@map("support_tickets")
}

// ---------------------------------------------------------------------------
// Phase 12C — Financial Intelligence Platform
// ---------------------------------------------------------------------------

model FinancialScore {
  id            String   @id @default(cuid())
  companyId     String
  scoreType     String /// "integrity" | "close-readiness" | "treasury-health" | "working-capital" | "operational" | "compliance"
  score         Float    @default(0) /// 0–100
  previousScore Float?   @map("previous_score")
  change        Float? /// absolute change
  changePercent Float?   @map("change_percent")
  severity      String   @default("normal") /// "critical" | "warning" | "normal" | "good"
  summary       String? /// engine-generated narrative
  components    Json? /// ScoreComponent[]
  evidence      Json? /// supporting evidence refs
  metadata      Json? /// extra context
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, scoreType, calculatedAt])
  @@map("financial_scores")
}

model KPIValue {
  id              String   @id @default(cuid())
  companyId       String
  kpiKey          String /// unique key per KPI
  label           String
  category        String /// "financial" | "treasury" | "risk" | "operational" | "compliance" | "executive"
  currentValue    Float
  previousValue   Float?
  targetValue     Float?
  thresholdLow    Float?
  thresholdHigh   Float?
  unit            String? /// "USD" | "days" | "ratio" | "percent" | "count"
  trend           String? /// "up" | "down" | "flat" | "volatile"
  variance        Float?
  variancePercent Float?   @map("variance_pct")
  status          String   @default("neutral") /// "on_track" | "at_risk" | "critical" | "neutral"
  metadata        Json?
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([companyId, kpiKey, recordedAt])
  @@index([companyId, category, status])
  @@map("kpi_values")
}

model IntelligenceRecommendation {
  id              String    @id @default(cuid())
  companyId       String
  category        String /// "integrity" | "close" | "treasury" | "working-capital" | "operational" | "compliance" | "general"
  title           String
  description     String?
  reason          String
  evidence        Json? /// supporting data references
  confidence      String    @default("medium") /// "high" | "medium" | "low"
  priority        String    @default("normal") /// "critical" | "high" | "normal" | "low"
  affectedModules Json? /// string[] — module names
  expectedImpact  String?
  status          String    @default("active") /// "active" | "acknowledged" | "implemented" | "dismissed"
  sourceScoreType String? /// originating score type
  actionUrl       String? /// deep link
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([companyId, category, status])
  @@index([companyId, priority, status])
  @@map("intelligence_recommendations")
}

model IntelligenceTrend {
  id            String   @id @default(cuid())
  companyId     String
  trendKey      String /// "score:integrity" | "kpi:dso" | "recommendation:count"
  label         String
  period        String /// "daily" | "weekly" | "monthly" | "quarterly" | "yearly"
  dataPoints    Json /// [{ date, value }]
  direction     String   @default("flat") /// "up" | "down" | "flat"
  changePercent Float?
  forecast      Json? /// [{ date, value, confidence }]
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calculatedAt  DateTime @default(now())

  @@unique([companyId, trendKey, period])
  @@index([companyId, period])
  @@map("intelligence_trends")
}

model InsightEvent {
  id          String   @id @default(cuid())
  companyId   String
  eventType   String /// "score_change" | "kpi_threshold" | "recommendation" | "alert" | "milestone"
  title       String
  description String?
  severity    String   @default("info") /// "critical" | "warning" | "info" | "positive"
  impact      String?
  evidence    Json? /// supporting data
  metadata    Json?
  isRead      Boolean  @default(false)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, eventType, severity])
  @@map("insight_events")
}

model HealthAlert {
  id           String    @id @default(cuid())
  companyId    String
  alertType    String /// "integrity_drop" | "close_risk" | "liquidity_decline" | "risk_increase" | "compliance_issue" | "recommendation_critical"
  title        String
  message      String?
  severity     String    @default("warning") /// "critical" | "warning" | "info"
  scoreType    String? /// associated score type
  threshold    Float?
  currentValue Float?
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([companyId, alertType, isResolved])
  @@index([companyId, severity, createdAt])
  @@map("health_alerts")
}

model ExecutiveScorecard {
  id              String   @id @default(cuid())
  companyId       String
  role            String /// "ceo" | "cfo" | "controller" | "treasurer" | "finance-manager" | "board" | "auditor"
  periodStart     DateTime
  periodEnd       DateTime
  scores          Json? /// { integrity: 85, closeReadiness: 72, ... }
  kpis            Json? /// role-specific KPI values
  recommendations Json? /// role-prioritized recommendations
  summary         String?
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedAt     DateTime @default(now())

  @@index([companyId, role, periodStart, periodEnd])
  @@map("executive_scorecards")
}

model ExplainSource {
  id          String   @id @default(cuid())
  companyId   String
  targetType  String /// "score" | "kpi" | "recommendation" | "metric"
  targetId    String /// ID of the target item
  sourceType  String /// "report" | "ledger" | "journal" | "transaction" | "document" | "import" | "integration" | "approval" | "audit"
  sourceId    String /// record ID in the source table
  sourceLabel String? /// human-readable label
  sourceUrl   String? /// deep link to source
  metadata    Json?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([companyId, targetType, targetId])
  @@index([companyId, sourceType, sourceId])
  @@map("explain_sources")
}

// ---------------------------------------------------------------------------
// Phase 12D — Platform Orchestration & Automation
// ---------------------------------------------------------------------------

model WorkflowExecution {
  id          String                  @id @default(cuid())
  companyId   String
  workflowId  String
  status      String                  @default("pending") /// "pending" | "running" | "completed" | "failed" | "rolled_back" | "cancelled"
  trigger     String /// "manual" | "event" | "schedule" | "automation"
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  retryCount  Int                     @default(0)
  maxRetries  Int                     @default(3)
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflow    WorkflowDefinition      @relation(fields: [workflowId], references: [id])
  steps       WorkflowStepExecution[]
  logs        WorkflowLog[]
  createdAt   DateTime                @default(now())

  @@index([companyId, workflowId, status])
  @@index([companyId, status, startedAt])
  @@map("workflow_executions")
}

model WorkflowStepExecution {
  id          String             @id @default(cuid())
  companyId   String
  executionId String
  workflowId  String
  stepIndex   Int
  stepType    String /// "module_action" | "condition" | "notification" | "delay" | "sub_workflow"
  module      String? /// treasury | ledger | reporting | integration | intelligence | approval | notification
  action      String? /// specific action to invoke
  input       Json?
  output      Json?
  status      String             @default("pending") /// "pending" | "running" | "completed" | "failed" | "skipped" | "rolled_back"
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  retryCount  Int                @default(0)
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflow    WorkflowDefinition @relation(fields: [workflowId], references: [id])
  execution   WorkflowExecution  @relation(fields: [executionId], references: [id])

  @@index([companyId, executionId])
  @@index([companyId, workflowId, status])
  @@map("workflow_step_executions")
}

model WorkflowTemplate {
  id                String   @id @default(cuid())
  companyId         String
  slug              String
  name              String
  description       String?
  category          String /// "month-end" | "treasury" | "reporting" | "reconciliation" | "budget" | "board" | "audit"
  steps             Json /// WorkflowStep[] definition
  estimatedDuration String? /// e.g. "45m"
  requiredModules   Json? /// string[] — modules this template requires
  isBuiltIn         Boolean  @default(true)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, category])
  @@map("workflow_templates")
}

model AutomationRule {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  eventType   String /// event that triggers evaluation
  condition   Json? /// condition expression
  actions     Json /// Action[] to execute
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  cooldownSec Int?     @map("cooldown_sec")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, eventType, isActive])
  @@map("automation_rules")
}

model WorkflowTrigger {
  id         String             @id @default(cuid())
  companyId  String
  workflowId String
  eventType  String /// event that triggers this workflow
  condition  Json? /// optional filter condition
  isActive   Boolean            @default(true)
  def        WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([companyId, eventType, isActive])
  @@map("workflow_triggers")
}

model WorkflowSchedule {
  id         String             @id @default(cuid())
  companyId  String
  workflowId String
  cron       String
  timezone   String             @default("UTC")
  isActive   Boolean            @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  def        WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([companyId, isActive])
  @@map("workflow_schedules")
}

model WorkflowLog {
  id          String             @id @default(cuid())
  companyId   String
  executionId String
  workflowId  String
  level       String             @default("info") /// "info" | "warn" | "error" | "debug"
  message     String
  metadata    Json?
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  execution   WorkflowExecution  @relation(fields: [executionId], references: [id])
  workflow    WorkflowDefinition @relation(fields: [workflowId], references: [id])
  createdAt   DateTime           @default(now())

  @@index([companyId, executionId])
  @@index([companyId, workflowId, level])
  @@map("workflow_logs")
}

model WorkflowMetric {
  id              String             @id @default(cuid())
  companyId       String
  workflowId      String
  periodStart     DateTime
  periodEnd       DateTime
  totalExecutions Int                @default(0)
  completed       Int                @default(0)
  failed          Int                @default(0)
  avgDurationMs   Int?               @map("avg_duration_ms")
  p95DurationMs   Int?               @map("p95_duration_ms")
  def             WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@index([companyId, workflowId, periodStart, periodEnd])
  @@map("workflow_metrics")
}

model WorkflowNotification {
  id         String             @id @default(cuid())
  companyId  String
  workflowId String
  triggerOn  String /// "complete" | "failure" | "approval_required" | "threshold"
  roleTarget String? /// role to notify
  channel    String             @default("in-app") /// "in-app" | "email" | "slack" | "all"
  template   String? /// message template
  isActive   Boolean            @default(true)
  def        WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([companyId, workflowId, triggerOn])
  @@map("workflow_notifications")
}

// ---------------------------------------------------------------------------
// Agent Framework — Enterprise Autonomous Finance
// ---------------------------------------------------------------------------

model AgentDefinition {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String  @default("")
  role        String /// "cfo_advisor" | "treasury_specialist" | "controller" | "audit" | "compliance" | "fp_and_a" | "custom"
  version     String  @default("1.0.0")
  owner       String? /// userId of creator
  enabled     Boolean @default(true)
  status      String  @default("DRAFT") /// "DRAFT" | "ACTIVE" | "PAUSED" | "DISABLED" | "ERROR"
  config      Json    @default("{}")
  metadata    Json    @default("{}")

  capabilities   AgentCapability[]
  sessions       AgentSession[]
  tasks          AgentTask[]
  executions     AgentExecution[]
  decisions      AgentDecision[]
  memories       AgentMemory[]
  configurations AgentPermission[]
  configuration  AgentConfiguration?
  healthChecks   AgentHealth[]
  delegations    AgentDelegation[]   @relation("DelegatingAgent")
  delegatedTo    AgentDelegation[]   @relation("ReceivingAgent")
  conversations  AgentConversation[]
  auditLogs      AgentAudit[]

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, status])
  @@index([companyId, role])
  @@map("agent_definitions")
}

model AgentCapability {
  id                  String   @id @default(cuid())
  companyId           String
  agentId             String
  name                String
  description         String   @default("")
  capabilityType      String /// "analysis" | "recommendation" | "execution" | "monitoring" | "reporting" | "investigation"
  inputSchema         Json     @default("{}")
  outputSchema        Json     @default("{}")
  requiredPermissions String[] @default([])
  requiredEvidence    String[] @default([])
  confidence          Decimal  @default(0) @db.Decimal(5, 4)
  riskLevel           String   @default("LOW") /// "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  requiresApproval    Boolean  @default(false)
  enabled             Boolean  @default(true)
  config              Json     @default("{}")

  agent      AgentDefinition  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executions AgentExecution[]
  tasks      AgentTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, name])
  @@index([companyId, agentId])
  @@index([companyId, capabilityType])
  @@map("agent_capabilities")
}

model AgentSession {
  id        String    @id @default(cuid())
  companyId String
  agentId   String
  userId    String? /// user who initiated or is interacting with this session
  status    String    @default("ACTIVE") /// "ACTIVE" | "PAUSED" | "COMPLETED" | "FAILED" | "TERMINATED"
  context   Json      @default("{}")
  config    Json      @default("{}")
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  duration  Int? /// milliseconds

  agent         AgentDefinition     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tasks         AgentTask[]
  conversations AgentConversation[]
  auditLogs     AgentAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, agentId])
  @@index([companyId, status])
  @@index([companyId, userId])
  @@map("agent_sessions")
}

model AgentTask {
  id           String    @id @default(cuid())
  companyId    String
  agentId      String
  sessionId    String?
  capabilityId String?
  name         String
  description  String    @default("")
  taskType     String /// "analysis" | "recommendation" | "execution" | "monitoring" | "reporting" | "investigation" | "collaboration"
  priority     Int       @default(50)
  status       String    @default("PENDING") /// "PENDING" | "RUNNING" | "COMPLETED" | "FAILED" | "CANCELLED" | "AWAITING_APPROVAL"
  input        Json      @default("{}")
  output       Json?
  error        Json?
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int? /// milliseconds
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  config       Json      @default("{}")

  agent       AgentDefinition   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session     AgentSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  capability  AgentCapability?  @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  execution   AgentExecution?
  delegations AgentDelegation[] @relation("DelegatingTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, agentId, status])
  @@index([companyId, status, priority])
  @@index([companyId, sessionId])
  @@map("agent_tasks")
}

model AgentExecution {
  id           String    @id @default(cuid())
  companyId    String
  taskId       String    @unique
  agentId      String
  capabilityId String?
  status       String    @default("RUNNING") /// "RUNNING" | "COMPLETED" | "FAILED" | "TIMEOUT" | "CANCELLED"
  input        Json      @default("{}")
  output       Json?
  error        Json?
  metrics      Json      @default("{}") /// execution time, tokens, API calls, etc.
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  duration     Int? /// milliseconds

  task       AgentTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent      AgentDefinition  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  capability AgentCapability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  evidence   AgentEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, agentId])
  @@index([companyId, status])
  @@index([companyId, startedAt])
  @@map("agent_executions")
}

model AgentDecision {
  id                String    @id @default(cuid())
  companyId         String
  agentId           String
  sessionId         String?
  taskId            String?
  title             String
  recommendation    String
  reason            String    @default("")
  confidence        Decimal   @default(0) @db.Decimal(5, 4)
  impact            String    @default("LOW") /// "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  risk              String    @default("LOW") /// "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  alternatives      Json      @default("[]")
  requiredApprovals String[]  @default([])
  status            String    @default("PENDING") /// "PENDING" | "APPROVED" | "REJECTED" | "EXECUTED" | "EXPIRED" | "CANCELLED"
  approvedBy        String?
  approvedAt        DateTime?
  executedAt        DateTime?
  evidence          Json      @default("[]") /// references to AgentEvidence
  metadata          Json      @default("{}")

  agent         AgentDefinition     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations AgentConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, agentId, status])
  @@index([companyId, status, createdAt])
  @@index([companyId, impact])
  @@map("agent_decisions")
}

model AgentEvidence {
  id             String    @id @default(cuid())
  companyId      String
  executionId    String
  sourceType     String /// "ledger" | "treasury" | "report" | "document" | "policy" | "audit" | "integration" | "intelligence"
  sourceId       String? /// reference ID in the source system
  sourceSystem   String /// "general_ledger" | "treasury" | "reporting" | etc.
  sourceModule   String? /// specific module name
  sourceRecordId String? /// specific record ID
  description    String    @default("")
  data           Json      @default("{}") /// snapshot of evidence data
  confidence     Decimal   @default(1) @db.Decimal(5, 4)
  relevance      Decimal   @default(1) @db.Decimal(5, 4)
  verified       Boolean   @default(false)
  verifiedAt     DateTime?

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId, executionId])
  @@index([companyId, sourceType])
  @@index([companyId, sourceSystem, sourceId])
  @@map("agent_evidence")
}

model AgentMemory {
  id             String    @id @default(cuid())
  companyId      String
  agentId        String
  userId         String? /// user-specific memory
  memoryType     String /// "short_term" | "long_term" | "user_preference" | "conversation" | "recommendation"
  category       String    @default("general")
  key            String
  value          Json
  importance     Decimal   @default(0.5) @db.Decimal(5, 4) /// 0-1 scale
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  expiresAt      DateTime?
  metadata       Json      @default("{}")

  agent AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, agentId, memoryType, key])
  @@index([companyId, agentId, memoryType])
  @@index([companyId, agentId, importance])
  @@index([companyId, userId])
  @@map("agent_memory")
}

model AgentHealth {
  id        String   @id @default(cuid())
  companyId String
  agentId   String
  status    String   @default("HEALTHY") /// "HEALTHY" | "DEGRADED" | "UNHEALTHY" | "UNKNOWN"
  checkType String /// "heartbeat" | "capability_test" | "resource_usage" | "error_rate" | "latency"
  message   String   @default("")
  metrics   Json     @default("{}")
  checkedAt DateTime @default(now())

  agent AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId, agentId, status])
  @@index([companyId, agentId, checkedAt])
  @@map("agent_health")
}

model AgentPermission {
  id         String    @id @default(cuid())
  companyId  String
  agentId    String
  permission String /// "ledger.read" | "treasury.execute" | "report.generate" | etc.
  effect     String    @default("ALLOW") /// "ALLOW" | "DENY"
  conditions Json      @default("{}") /// optional conditions (threshold, time, etc.)
  reason     String    @default("")
  grantedBy  String? /// userId who granted
  expiresAt  DateTime?

  agent AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, agentId, permission])
  @@index([companyId, agentId])
  @@index([companyId, permission])
  @@map("agent_permissions")
}

model AgentConfiguration {
  id                 String   @id @default(cuid())
  companyId          String
  agentId            String   @unique
  maxConcurrentTasks Int      @default(5)
  taskTimeout        Int      @default(300000) /// milliseconds (5 min default)
  maxRetries         Int      @default(3)
  rateLimitPerMinute Int      @default(60)
  allowedActions     String[] @default([])
  forbiddenActions   String[] @default([])
  escalationRules    Json     @default("{}")
  safetyPolicies     Json     @default("{}")
  notificationPrefs  Json     @default("{}")
  config             Json     @default("{}")

  agent AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_configurations")
}

model AgentConversation {
  id          String  @id @default(cuid())
  companyId   String
  sessionId   String
  agentId     String
  decisionId  String?
  role        String /// "agent" | "user" | "system"
  content     String
  contentType String  @default("text") /// "text" | "evidence" | "decision" | "question" | "clarification"
  metadata    Json    @default("{}")

  session  AgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent    AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  decision AgentDecision?  @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, sessionId])
  @@index([companyId, agentId])
  @@index([companyId, role])
  @@map("agent_conversations")
}

model AgentDelegation {
  id             String    @id @default(cuid())
  companyId      String
  fromAgentId    String
  toAgentId      String
  taskId         String?
  delegationType String /// "full_delegation" | "partial_delegation" | "consultation" | "escalation"
  reason         String    @default("")
  status         String    @default("PENDING") /// "PENDING" | "ACCEPTED" | "REJECTED" | "COMPLETED" | "EXPIRED"
  context        Json      @default("{}")
  result         Json?
  traceId        String? /// distributed trace ID for full traceability
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  fromAgent AgentDefinition @relation("DelegatingAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgent   AgentDefinition @relation("ReceivingAgent", fields: [toAgentId], references: [id], onDelete: Cascade)
  task      AgentTask?      @relation("DelegatingTask", fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, fromAgentId])
  @@index([companyId, toAgentId])
  @@index([companyId, status])
  @@index([companyId, traceId])
  @@map("agent_delegations")
}

model AgentAudit {
  id            String  @id @default(cuid())
  companyId     String
  agentId       String
  sessionId     String?
  action        String /// "agent.registered" | "agent.started" | "agent.stopped" | "task.created" | "task.completed" | "decision.made" | "decision.approved" | "decision.rejected" | "evidence.collected" | "delegation.created" | "permission.granted" | "permission.revoked" | "memory.stored" | "memory.accessed" | "health.checked"
  resourceType  String  @default("Agent")
  resourceId    String?
  actorUserId   String?
  actorAgentId  String?
  before        Json?
  after         Json?
  metadata      Json    @default("{}")
  ipAddress     String?
  correlationId String?

  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session AgentSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, agentId, action])
  @@index([companyId, action, createdAt])
  @@index([companyId, sessionId])
  @@index([companyId, correlationId])
  @@map("agent_audit")
}

