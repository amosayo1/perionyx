  certifications      Json     @default("[]")
  erpExperience       Json     @default("[]")        @map("erp_experience")
  accountingStandards Json     @default("[]")        @map("accounting_standards")
  companySize         String?  @map("company_size")
  country             String?
  region              String?
  decisionAuthority   String?  @map("decision_authority")
  technologyStack     Json     @default("[]")        @map("technology_stack")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_professional_profiles")
}

model Interaction {
  id            String               @id @default(cuid())
  contactId     String               @map("contact_id")
