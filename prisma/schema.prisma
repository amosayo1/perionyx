// ── Data Classification ───────────────────────────────────────────────────

enum RuntimeClassificationLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
  TOP_SECRET
  RESTRICTED
  SENSITIVE
  PROPRIETARY
  PII
  PHI
  SYSTEM
}

model RuntimeClassificationEntry {
  id        String  @id @default(cuid())
  companyId String?

  /// Entity type + field name (e.g., "User.email")
  entityType String
  fieldName  String

  /// Classification level for this specific field
  level RuntimeClassificationLevel @default(INTERNAL)

  /// Field-level policy overrides (masking, encryption, access rules)
  policy Json?

  /// Source: "manual" or "auto" (auto-registered from Prisma schema)
  source String @default("manual")

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, fieldName])
  @@index([entityType])
  @@index([level])
  @@index([companyId])
}

model RuntimeClassificationEntity {
  id        String  @id @default(cuid())
  companyId String?

  /// Entity type (e.g., "User", "Transaction")
  entityType String @unique

  /// Default classification for all fields in this entity
  level RuntimeClassificationLevel @default(INTERNAL)

  /// Entity-level policy (encryption, retention, access rules)
  policy Json?

  /// Source: "manual" or "auto"
  source String @default("manual")

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([level])
  @@index([entityType])
}

model RuntimeClassificationAudit {
  id        String  @id @default(cuid())
  companyId String?

  /// What was classified
  entityType String
  entityId   String?
  fieldName  String?

  /// Classification decision
  level RuntimeClassificationLevel

  /// Access check result
  granted  Boolean
  userRole String?
  reason   String?

  /// Request context
  userId        String?
  correlationId String?
  ipAddress     String?

  /// Masking applied
  maskingApplied String? // REDACT, PARTIAL, HASH, TOKENIZE

  /// Timestamp — append-only
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([level])
  @@index([granted])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

