  feature          String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Decimal @default(0) @db.Decimal(18, 10)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([provider, createdAt])
  @@index([model, createdAt])
  @@map("ai_usage")
}

model AiProviderHealth {
  id        String   @id @default(cuid())
  provider  String
  status    String
  latency   Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([provider, checkedAt])
  @@map("ai_provider_health")
}

// ---------------------------------------------------------------------------
// Governance — Enterprise Governance & Policy Engine (Phase 7A)
// ---------------------------------------------------------------------------

/// Groups policies into regulatory/compliance frameworks (SOX, PCI, etc.)
model GovernanceFramework {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  category    String  @default("internal") /// "regulatory" | "internal" | "compliance"
  status      String  @default("ACTIVE") /// ACTIVE | DRAFT | ARCHIVED
  version     Int     @default(1)

  policies GovernanceFrameworkPolicy[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("governance_frameworks")
}

/// Links policies to governance frameworks
model GovernanceFrameworkPolicy {
  id          String @id @default(cuid())
  frameworkId String
  policyId    String
  mappingType String @default("MANDATORY") /// MANDATORY | OPTIONAL | RECOMMENDED

  framework GovernanceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, policyId])
  @@index([frameworkId])
  @@map("governance_framework_policies")
}

/// Captures policy/rule violations with lifecycle tracking
model PolicyViolation {
  id        String @id @default(cuid())
  companyId String

  policyId     String?
  sourceModule String /// "policy_engine" | "approval_rule" | "risk" | "compliance"
  sourceId     String? /// The evaluation/check/alert ID that generated this violation

  severity    String  @default("MEDIUM") /// LOW | MEDIUM | HIGH | CRITICAL
  status      String  @default("OPEN") /// OPEN | ACKNOWLEDGED | INVESTIGATING | RESOLVED | DISMISSED
  title       String
  description String?

  entityType String? /// Transaction | Wallet | Connector | etc.
  entityId   String?
  action     String? /// BLOCK | FLAG | REQUIRE_APPROVAL | NOTIFY
  details    Json?

  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  exceptionId  String? /// If resolved via a PolicyException

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, severity])
  @@index([companyId, createdAt])
  @@index([policyId])
  @@map("policy_violations")
}

/// Temporary overrides to policies with justification and expiry
model PolicyException {
  id        String @id @default(cuid())
  companyId String
  version   Int    @default(1)

  policyId    String?
  ruleId      String?
  grantedById String?
  grantedToId String?

  reason   String /// Justification
  scope    String  @default("GLOBAL") /// GLOBAL | TRANSACTION | WALLET | USER | ROLE
  scopeId  String?
  criteria Json? /// Optional constraints on the exception

  expiresAt DateTime?
  status    String    @default("ACTIVE") /// ACTIVE | EXPIRED | REVOKED

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([policyId])
  @@map("policy_exceptions")
}

// ---------------------------------------------------------------------------
// Enterprise Time Machine — Object Versioning (Phase 19)
// ---------------------------------------------------------------------------

enum VersionChangeType {
  CREATE
  UPDATE
  DELETE
}

model ObjectVersion {
  id                String            @id @default(cuid())
  companyId         String
  entityType        String /// Transaction, LedgerEntry, TransactionApproval, Policy, RiskIncident, TreasuryAccount
  entityId          String /// The ID of the tracked entity
  version           Int /// Monotonic version per (entityType, entityId)
  data              Json /// Full snapshot of the entity at this version
  changedByUserId   String?
  changeType        VersionChangeType @default(UPDATE)
  changedFields     String[] /// Field names that changed in this version
  previousVersionId String? /// Link to previous version for chain traversal

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("ObjectVersionAuthor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([companyId, entityType, entityId, version])
  @@index([companyId, entityType, entityId, createdAt])
  @@index([companyId, entityType, entityId, version])
  @@index([previousVersionId])
  @@map("object_versions")
}

// ---------------------------------------------------------------------------
// Notifications (Phase 18)
// ---------------------------------------------------------------------------

enum NotificationEventType {
  APPROVAL_REQUIRED
  APPROVAL_COMPLETED
  APPROVAL_REJECTED
  RISK_ALERT_CREATED
  RISK_ALERT_RESOLVED
  RECONCILIATION_COMPLETED
  RECONCILIATION_FAILED
  POLICY_VIOLATION
  CONNECTOR_FAILURE
  TRANSFER_COMPLETED
  TRANSFER_FAILED
  CALENDAR_EVENT_REMINDER
  PLAID_SYNC_FAILED
  PLAID_ACCOUNT_LINKED
  PLAID_ACCOUNT_UNLINKED
}

model NotificationChannel {
  id        String   @id @default(cuid())
  companyId String
  type      String   @default("IN_APP") /// IN_APP | EMAIL | SLACK
  name      String /// e.g. "Engineering Slack", "Finance Email"
  config    Json /// { webhookUrl?, email?, smtpHost?, smtpPort?, smtpUser?, smtpPass? }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  preferences NotificationPreference[]

  @@map("notification_channels")
}

model NotificationPreference {
  id        String                @id @default(cuid())
  userId    String
  companyId String
  eventType NotificationEventType
  channelId String?
  enabled   Boolean               @default(true)
  createdAt DateTime              @default(now())

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId, eventType, channelId])
  @@map("notification_preferences")
}

model License {
  id               String    @id @default(cuid())
  companyId        String    @unique
  key              String    @unique
  status           String    @default("ACTIVE") /// ACTIVE | REVOKED | EXPIRED
  seats            Int       @default(5)
  features         Json      @default("{}")
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revocationReason String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([key])
  @@map("licenses")
}

model Notification {
  id        String                @id @default(cuid())
  companyId String
  userId    String? /// null = broadcast to company
  eventType NotificationEventType
  title     String
  message   String?
  metadata  Json?
  link      String? /// deep link to resource
  channel   String                @default("IN_APP")
  read      Boolean               @default(false)
  sentAt    DateTime?
  createdAt DateTime              @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, read])
  @@index([companyId, createdAt])
  @@map("notifications")
}

model DemoRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String
  role        String
  companySize String?
  country     String?
  message     String?
  status      String   @default("PENDING")
  source      String   @default("WEB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("demo_requests")
}

// ---------------------------------------------------------------------------
// Enterprise Workflow Engine (Phase 7B)
// ---------------------------------------------------------------------------

/// Blueprint/template for a workflow. Steps are stored as JSON.
model WorkflowDefinition {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  category    String  @default("general") /// approval | decision | connector | notification | report | custom

  /// JSON array of step definitions: [{id, type, label, config, dependsOn[], timeoutMinutes?, retryCount?, retryDelayMs?}]
  steps Json

  inputSchema  Json?
  outputSchema Json?

  version  Int     @default(1)
  status   String  @default("ACTIVE") /// ACTIVE | DRAFT | ARCHIVED
  isSystem Boolean @default(false)

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instances WorkflowInstance[]

  // Phase 12D — Orchestration reverse relations
  executions     WorkflowExecution[]
  stepExecutions WorkflowStepExecution[]
  triggers       WorkflowTrigger[]
  schedules      WorkflowSchedule[]
  logs           WorkflowLog[]
  metrics        WorkflowMetric[]
  notifications  WorkflowNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("workflow_definitions")
}

/// A running execution of a workflow definition.
model WorkflowInstance {
  id           String             @id @default(cuid())
  companyId    String
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id])

  status String @default("PENDING") /// PENDING | VALIDATED | RUNNING | WAITING | PAUSED | COMPLETED | FAILED | CANCELLED | ARCHIVED

  currentStepId   String?
  currentStepType String?

  input     Json?
  output    Json?
  variables Json  @default("{}")
  metadata  Json  @default("{}")

  initiatedById String?
  assignedToId  String?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  archivedAt  DateTime?

  lastError  String?
  errorCount Int     @default(0)
  retryCount Int     @default(0)

  scheduledFor   DateTime?
  cronExpression String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  steps  WorkflowStepInstance[]
  events WorkflowEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, definitionId])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([companyId, scheduledFor])
  @@index([definitionId])
  @@map("workflow_instances")
}

/// An individual step within a workflow execution.
model WorkflowStepInstance {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  stepId   String /// Reference to the step definition ID
  stepType String /// approval | decision | policy_evaluation | notification | delay | conditional | connector_execution | report_generation | human_task | ai_recommendation | custom
  label    String

  status String @default("PENDING") /// PENDING | READY | RUNNING | COMPLETED | FAILED | SKIPPED | WAITING_APPROVAL | WAITING_INPUT

  config Json?
  input  Json?
  output Json?

  error      String?
  retryCount Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  dependsOn String[]

  companyId String

  events WorkflowEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instanceId])
  @@index([instanceId, status])
  @@index([companyId])
  @@index([companyId, status])
  @@map("workflow_step_instances")
}

/// Execution history event for a workflow instance.
model WorkflowEvent {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  stepInstanceId String?
  stepInstance   WorkflowStepInstance? @relation(fields: [stepInstanceId], references: [id], onDelete: SetNull)

  stepId      String?
  eventType   String /// CREATED | STARTED | STEP_STARTED | STEP_COMPLETED | STEP_FAILED | APPROVAL_REQUESTED | APPROVAL_GRANTED | APPROVAL_REJECTED | NOTIFICATION_SENT | RETRY_TRIGGERED | COMPLETED | CANCELLED | FAILED | TIMEOUT | ESCALATED | PAUSED | RESUMED | ARCHIVED
  label       String
  description String?
  actorId     String?
  metadata    Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())

  @@index([instanceId])
  @@index([instanceId, timestamp])
  @@index([stepInstanceId])
  @@index([companyId])
  @@index([companyId, timestamp])
  @@map("workflow_events")
}

// ---------------------------------------------------------------------------
// Automation Studio — Phase 7E Persistence
// ---------------------------------------------------------------------------

/// Automation template — a reusable workflow blueprint with metadata
model AutomationTemplate {
  id          String @id @default(cuid())
  companyId   String
  name        String
  description String @default("")

  category String @default("general") /// approval | treasury | compliance | etc.
  icon     String @default("FileText")
  kind     String @default("semi_automated") /// automated | semi_automated | manual

  /// JSON array of StepDefinition
  steps        Json
  inputSchema  Json?
  outputSchema Json?

  triggerType String @default("manual") /// manual | scheduled | event
  popularity  String @default("medium") /// high | medium | low
  status      String @default("active") /// active | draft | archived

  /// Metadata stored as JSON: { author, version, tags[], riskLevel, estimatedDuration, requiresApproval, defaultSchedule }
  metadata Json @default("{}")

  version Int @default(1)

  isSystem Boolean @default(false)

  createdByUserId String?
  updatedByUserId String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AutomationTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("AutomationTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, category])
  @@index([companyId, status])
  @@index([companyId, triggerType])
  @@map("automation_templates")
}

/// Approval matrix rule — determines WHO can approve WHAT based on roles, amounts, departments
model ApprovalMatrixRule {
  id        String @id @default(cuid())
  companyId String

  name        String
  description String @default("")

  /// Lower = higher priority (evaluated first)
  priority Int @default(100)

  /// JSON array of ApprovalCondition: [{ field, operator, value }]
  conditions Json @default("[]")

  /// Approval requirements
  requiredApprovers Int      @default(1)
  approverRoles     String[] /// e.g. ["finance_manager", "cfo"]
  approvalMode      String   @default("sequential") /// "sequential" | "parallel"

  /// Timeout & escalation
  timeoutMinutes         Int      @default(1440)
  escalationEnabled      Boolean  @default(false)
  escalationDelayMinutes Int?
  escalationRoles        String[]

  /// Delegation
  delegationEnabled Boolean  @default(false)
  delegationRoles   String[]

  /// Department scope (null = all departments)
  departmentScope String?

  /// Amount threshold matching
  thresholdField    String? /// e.g. "amount"
  thresholdOperator String? /// "gt" | "gte" | "lt" | "lte" | "eq" | "neq"
  thresholdValue    Decimal?  @db.Decimal(20, 4)

  /// Status
  isActive Boolean @default(true)

  /// Optimistic lock
  version Int @default(1)

  /// Audit
  createdByUserId String?
  updatedByUserId String?
  createdBy       User?   @relation("ApprovalMatrixRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?   @relation("ApprovalMatrixRuleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, isActive, priority])
  @@index([companyId, departmentScope])
  @@map("approval_matrix_rules")
}

/// Structured business rule with condition groups, actions, and priority ordering
model BusinessRuleDefinition {
  id        String @id @default(cuid())
  companyId String

  name        String
  description String @default("")

  category String @default("general") /// approval | financial | compliance | integration | notification | report | custom

  /// Evaluation priority (lower = higher priority)
  priority Int @default(50)

  /// JSON: ConditionGroup { logic: "AND"|"OR", conditions: [ConditionGroup|RuleCondition] }
  when Json

  /// JSON array: RuleAction[] [{ type, config }]
  then Json

  /// Status
  isActive Boolean @default(true)

  /// Optimistic lock
  version Int @default(1)

  /// Audit
  createdByUserId String?
  updatedByUserId String?
  createdBy       User?   @relation("BusinessRuleDefinitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?   @relation("BusinessRuleDefinitionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, isActive, priority])
  @@index([companyId, category])
  @@map("business_rule_definitions")
}

/// Automation schedule — dictates WHEN and HOW a workflow is triggered
model AutomationSchedule {
  id        String @id @default(cuid())
  companyId String

  name String

  /// Trigger configuration
  triggerType String /// immediate | scheduled | recurring | cron | webhook | manual | *_event

  /// Cron / timing
  cronExpression String?
  startAt        DateTime?

  /// Event source matching
  eventSource String? /// "plaid" | "stripe" | "sap"
  eventType   String? /// "transaction.posted" | "payment.received"

  /// Target workflow
  templateId  String? /// FK to automation_templates.id (loose reference)
  blueprintId String? /// FK to WorkflowDefinition.id (loose reference)

  /// Static input parameters merged at trigger time
  input Json?

  /// Runtime tracking
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  /// Optimistic lock
  version Int @default(1)

  /// Audit
  createdByUserId String?
  updatedByUserId String?
  createdBy       User?   @relation("AutomationScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?   @relation("AutomationScheduleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, enabled, triggerType])
  @@index([companyId, eventType])
  @@index([companyId, nextRunAt])
  @@map("automation_schedules")
}

/// Persisted enterprise readiness report
model ReadinessReport {
  id        String @id @default(cuid())
  companyId String

  /// Overall score 0-100
  overallScore Int

  /// Summary counts
  passedChecks Int @default(0)
  warnedChecks Int @default(0)
  failedChecks Int @default(0)

  /// Full report: JSON array of ReadinessCheckResult
  checks Json

  /// Aggregated unique suggestions
  suggestions String[]

