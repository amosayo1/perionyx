model IntegrationConnectorDef {
  id               String                @id @default(cuid())
  provider         String                @unique
  name             String
  description      String
  category         String /// "erp" | "banking" | "crm" | "hr" | "payroll" | "payment" | "file" | "messaging"
  authTypes        Json /// string[] — auth method types
  supportedModules Json /// string[] — module names
  capabilities     Json /// string[] — capability flags
  configSchema     Json? /// JSON Schema for configuration
  isActive         Boolean               @default(true)
  iconUrl          String?
  docsUrl          String?
  version          String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  instances        IntegrationInstance[]

  @@map("integration_connector_defs")
}

model IntegrationInstance {
  id                String                  @id @default(cuid())
  companyId         String
  connectorDefId    String
  name              String
  status            String /// ConnectionStatus enum value
  healthStatus      String                  @default("unknown") /// HealthStatus enum value
  config            Json /// provider-specific config
  authMethod        String
  isActive          Boolean                 @default(true)
  lastSyncAt        DateTime?
  lastHealthCheckAt DateTime?
  error             String?
  version           Int                     @default(1)
  metadata          Json? /// Additional metadata
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectorDef      IntegrationConnectorDef @relation(fields: [connectorDefId], references: [id])
  credentials       IntegrationCredential[]
  syncHistory       SyncHistory[]
  healthRecords     IntegrationHealth[]
  lineageRecords    LineageRecord[]
  auditRecords      IntegrationAudit[]
  conflicts         ConflictRecord[]
  bankConnections   BankConnection[]
  validationIssues  ValidationIssue[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([companyId, status])
  @@index([companyId, connectorDefId])
  @@map("integration_instances")
}

model IntegrationCredential {
  id             String              @id @default(cuid())
  instanceId     String
  companyId      String
  key            String
  encryptedValue String
  expiresAt      DateTime?
  rotatedAt      DateTime?
  version        Int                 @default(1)
  instance       IntegrationInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([instanceId, key])
  @@map("integration_credentials")
}

model SyncHistory {
  id           String              @id @default(cuid())
  instanceId   String
  companyId    String
  syncType     String /// "full" | "incremental" | "manual"
  status       String /// SyncStatus enum value
  startedAt    DateTime
  completedAt  DateTime?
  durationMs   Int?
  totalRecords Int                 @default(0)
  inserted     Int                 @default(0)
  updated      Int                 @default(0)
  skipped      Int                 @default(0)
  failed       Int                 @default(0)
  error        String?
  details      Json?
  instance     IntegrationInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@index([companyId, instanceId])
  @@index([companyId, status])
  @@index([companyId, startedAt])
  @@map("sync_history")
}

model ImportTemplate {
  id           String           @id @default(cuid())
  companyId    String
  name         String
  sourceType   String /// "csv" | "excel" | "erp"
  mapping      Json /// FieldMapping[]
  preview      Json?
  isActive     Boolean          @default(true)
  isShared     Boolean          @default(false)
  createdBy    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mappingRules CsvMappingRule[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

