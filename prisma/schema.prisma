}

// ---------------------------------------------------------------------------
// Copilot / AI Conversations
// ---------------------------------------------------------------------------

model CopilotConversation {
  id        String @id @default(cuid())
  companyId String
  userId    String
  title     String @default("New conversation")
  modelUsed String @default("gpt-4o-mini")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  messages CopilotMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, userId, updatedAt])
  @@map("copilot_conversations")
}

model CopilotMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String /// "user" | "assistant"
  content        String
  citations      String[] @default([])
  followUps      String[] @default([])

  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("copilot_messages")
}

// ---------------------------------------------------------------------------
// Intelligence Snapshots — Metric History for Trend Analysis
// ---------------------------------------------------------------------------

model IntelligenceSnapshot {
  id        String  @id @default(cuid())
  companyId String
  metric    String /// e.g. "cash_position", "risk_score", "approval_sla", "operational_efficiency"
  value     Decimal @db.Decimal(38, 12)
  label     String? /// Human-readable label for the metric
  metadata  Json? /// Extra context (e.g. { currency: "USD", walletCount: 5 })

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  takenAt DateTime @default(now())

  @@index([companyId, metric, takenAt])
  @@map("intelligence_snapshots")
