  frequency      String /// ScheduleFrequency enum value
  cronExpression String?
  recipients     Json /// string[] — user IDs or emails
  format         String /// ExportFormat enum value
  config         Json /// ReportConfig snapshot
  isActive       Boolean                    @default(true)
  lastRunAt      DateTime?
  lastRunStatus  String?
  nextRunAt      DateTime?
  createdBy      String
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  definition     FinancialReportDefinition? @relation(fields: [definitionId], references: [id])
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, nextRunAt])
