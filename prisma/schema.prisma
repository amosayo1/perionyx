  year              Int
  status            String    @default("DRAFT") /// "DRAFT" | "GENERATING" | "READY" | "DISTRIBUTED"
  sections          Json      @default("[]")
  highlights        Json      @default("{}")
  commentary        Json      @default("{}")
  risks             Json      @default("[]")
  opportunities     Json      @default("[]")
  capitalAllocation Json      @default("{}")
  cashStrategy      Json      @default("{}")
