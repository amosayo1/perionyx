// ── Event Outbox ──────────────────────────────────────────────────────────

enum RuntimeEventStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTER
  REPLAYED
}

model RuntimeEventEnvelope {
  id        String  @id @default(cuid())
  companyId String?

  /// Event type (e.g., "invoice.created", "payment.executed")
  type String

  /// Event payload
  payload Json

  /// Delivery status
  status RuntimeEventStatus @default(PENDING)

  /// Correlation chain
  correlationId String?
  causationId   String? // the event that caused this event

  /// Versioning
  schemaVersion Int @default(1)

  /// Retry tracking
  attemptCount Int      @default(0)
  maxAttempts  Int      @default(3)
  nextRetryAt  DateTime?

  /// Error tracking (on failure)
  lastError     String?
  lastAttemptAt DateTime?

  /// Metadata
  metadata Json?

  /// Timestamp — append-only
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([companyId, type])
  @@index([status, createdAt])    // for outbox polling
  @@index([status, nextRetryAt])  // for retry polling
  @@index([correlationId])
  @@index([createdAt])
}

model RuntimeEventDeadLetter {
  id        String  @id @default(cuid())
  companyId String?

  /// Original event data
  type    String
  payload Json

  /// Failure tracking
  error         String
  attemptCount  Int
  firstFailedAt DateTime @default(now())
  lastFailedAt  DateTime @default(now())

  /// Original context
  correlationId String?
  causationId   String?

  /// Resolution
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  resolveNote String?

  /// Metadata
  metadata Json?

  @@index([companyId])
  @@index([type])
  @@index([resolved])
  @@index([companyId, resolved])
  @@index([firstFailedAt])
}
