model CrmKnowledgeLink {
  id                  String   @id @default(cuid())
  sourceContactId     String   @map("source_contact_id")
  sourceContact       Contact  @relation("SourceContact", fields: [sourceContactId], references: [id], onDelete: Cascade)
  targetContactId     String?  @map("target_contact_id")
  targetContact       Contact? @relation("TargetContact", fields: [targetContactId], references: [id], onDelete: SetNull)

  targetCompany       String?  @map("target_company")
  targetIndustry      String?  @map("target_industry")
  targetPainPoint     String?  @map("target_pain_point")
  targetErp           String?  @map("target_erp")
  targetWorkflow      String?  @map("target_workflow")
  targetModule        String?  @map("target_module")
  targetFeature       String?  @map("target_feature")
  targetRoadmap       String?  @map("target_roadmap")
  targetConstitution  String?  @map("target_constitution")
  targetInterview     String?  @map("target_interview")
  targetRecommendation String? @map("target_recommendation")

  linkType    String
  strength    Int?
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sourceContactId])
  @@index([targetContactId])
  @@index([linkType])
  @@map("crm_knowledge_graph")
