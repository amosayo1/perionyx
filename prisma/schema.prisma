  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@index([paymentBatchId])
  @@index([vendorInvoiceId])
  @@index([vendorId])
  @@index([companyId, status])
  @@index([companyId, paymentDate])
  @@index([companyId, vendorId])
  @@index([vendorInvoiceId, status])
