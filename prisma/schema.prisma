  /// Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  @@index([companyId])
  @@index([threeWayMatchId])
  @@index([invoiceLineItemId])
  @@index([poReferenceLineItemId])
}

