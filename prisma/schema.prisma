}

model ExecutiveRecommendation {
  id                 String   @id @default(cuid())
  companyId          String
  briefingId         String?
  category           String /// "cash" | "liquidity" | "working_capital" | "revenue" | "expense" | "treasury" | "compliance" | "risk" | "close" | "strategic"
  title              String
  executiveSummary   String   @default("")
  businessReason     String   @default("")
  financialImpact    Json     @default("{}")
  confidence         Decimal  @default(0) @db.Decimal(5, 4)
  riskLevel          String   @default("LOW") /// "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  priority           Int      @default(50)
  status             String   @default("PENDING") /// "PENDING" | "ACKNOWLEDGED" | "ACCEPTED" | "REJECTED" | "EXECUTED"
  requiredApprovals  String[] @default([])
  suggestedNextSteps Json     @default("[]")
  evidenceIds        String[] @default([])
  agentDecisionId    String?
  metadata           Json     @default("{}")

  briefing  ExecutiveBriefing? @relation(fields: [briefingId], references: [id], onDelete: SetNull)
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([companyId, category])
  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([companyId, briefingId])
  @@map("executive_recommendations")
}

model ScenarioAnalysis {
  id                  String    @id @default(cuid())
  companyId           String
  name                String
  description         String    @default("")
  scenarioType        String /// "revenue_decline" | "revenue_growth" | "payroll_increase" | "hiring_freeze" | "customer_default" | "fx_movement" | "interest_rate" | "tax_increase" | "acquisition" | "capex" | "custom"
  status              String    @default("DRAFT") /// "DRAFT" | "RUNNING" | "COMPLETED" | "FAILED"
  parameters          Json      @default("{}")
  assumptions         Json      @default("[]")
  results             Json      @default("{}")
  riskAssessment      Json      @default("{}")
  recommendations     Json      @default("[]")
  sensitivityAnalysis Json      @default("{}")
  runAt               DateTime?
  completedAt         DateTime?
  duration            Int? /// milliseconds

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executions ScenarioExecution[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([companyId, scenarioType])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("scenario_analyses")
}

model ScenarioExecution {
  id          String    @id @default(cuid())
  companyId   String
  scenarioId  String
  status      String    @default("RUNNING") /// "RUNNING" | "COMPLETED" | "FAILED"
  input       Json      @default("{}")
  output      Json      @default("{}")
  error       Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?

  scenario ScenarioAnalysis @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId, scenarioId])
  @@index([companyId, status])
  @@map("scenario_executions")
}

model ExecutiveConversation {
  id        String @id @default(cuid())
  companyId String
  userId    String
  title     String @default("New Conversation")
  status    String @default("ACTIVE") /// "ACTIVE" | "ARCHIVED"
  context   Json   @default("{}")
  metadata  Json   @default("{}")

  messages ExecutiveMessage[]

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, userId])
  @@index([companyId, status])
  @@map("executive_conversations")
}

model ExecutiveMessage {
  id             String @id @default(cuid())
  companyId      String
  conversationId String
  role           String /// "user" | "advisor" | "system"
  content        String
  contentType    String @default("text") /// "text" | "briefing" | "recommendation" | "scenario" | "evidence" | "decision"
  references     Json   @default("[]") /// evidence, reports, decisions referenced
  metadata       Json   @default("{}")

  conversation ExecutiveConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId, conversationId])
  @@index([companyId, role])
  @@map("executive_messages")
}

model ExecutiveInsight {
  id             String    @id @default(cuid())
  companyId      String
  insightType    String /// "trend" | "anomaly" | "risk" | "opportunity" | "alert" | "milestone"
  category       String /// "cash" | "revenue" | "expense" | "liquidity" | "compliance" | "operational"
  title          String
  description    String    @default("")
  severity       String    @default("INFO") /// "INFO" | "WARNING" | "CRITICAL"
  data           Json      @default("{}")
  sourceType     String /// "briefing" | "scenario" | "recommendation" | "system"
  sourceId       String?
  acknowledged   Boolean   @default(false)
