  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([severity])
  @@index([trend])
  @@index([frequency])
  @@index([contactId])
  @@map("crm_pain_points")
}

model ProductDiscoverySession {
  id                      String          @id @default(cuid())
  contactId               String          @map("contact_id")
  contact                 Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  discoveryStage          DiscoveryStage? @default(RESEARCH) @map("discovery_stage")
