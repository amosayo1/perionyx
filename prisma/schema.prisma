// ── Configuration ─────────────────────────────────────────────────────────

enum RuntimeConfigScope {
  GLOBAL
  ENVIRONMENT
  TENANT
  PROVIDER
}

enum RuntimeConfigStatus {
  ACTIVE
  DEPRECATED
  OVERRIDDEN
  DELETED
}

model RuntimeConfiguration {
  id        String             @id @default(cuid())
  companyId String?

  /// Configuration key — unique within scope
  key   String
  scope RuntimeConfigScope

  /// Value stored as JSON for flexibility (string, number, boolean, object, array)
  value Json

  /// Environment filter (null = all environments)
  environment String?

  /// Provider filter (null = all providers)
  provider String?

  /// Metadata
  status      RuntimeConfigStatus @default(ACTIVE)
  sensitive   Boolean             @default(false)
  description String?
  tags        String?             // comma-separated

  /// Ownership
  createdBy String?
  updatedBy String?

  /// Schema reference — key into registered ConfigSchemaDefinition
  schemaKey String?

  /// Version tracking
  version Int @default(1)

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unique per scope
  @@unique([key, scope, companyId, environment, provider])
  @@index([companyId, key])
  @@index([scope])
  @@index([companyId, scope])
  @@index([status])
  @@index([key])
  @@index([companyId])
}

model RuntimeConfigurationVersion {
  id        String  @id @default(cuid())
  configId  String
  companyId String?

  /// Snapshot of the value at this version
  value Json
  version Int

  /// Who changed it and why
  changedBy  String?
  changeNote String?

  /// Timestamp — append-only
  createdAt DateTime @default(now())

  @@index([configId])
  @@index([companyId, configId])
  @@index([createdAt])
}

// ── Feature Flags ─────────────────────────────────────────────────────────

enum RuntimeFeatureFlagStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum RuntimeFeatureFlagRollout {
  ALL
  PERCENTAGE
  TENANT
  ENVIRONMENT
}

model RuntimeFeatureFlag {
  id        String  @id @default(cuid())
  companyId String?

  /// Unique flag key (e.g., "ap.three-way-matching")
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?

  /// Rollout strategy
  rolloutStrategy RuntimeFeatureFlagRollout @default(ALL)
  percentage      Int?                      // 0-100, used when strategy = PERCENTAGE
  allowedEnvs     String?                   // comma-separated: "production,staging"
  allowedTenants  String?                   // comma-separated tenant IDs

  /// Tags for grouping (e.g., "ap,finance,beta")
  tags String?

  /// Status
  status RuntimeFeatureFlagStatus @default(ACTIVE)

  /// Ownership
  createdBy  String?
  updatedBy  String?
  ownerTeam  String? // e.g., "platform", "payments", "ai"

  /// Scheduling
  activatesAt DateTime? // scheduled activation
  expiresAt   DateTime? // auto-disable after this date

  /// Metadata
  metadata Json?

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([tags])
  @@index([companyId, key])
}

model RuntimeFeatureFlagOverride {
  id        String  @id @default(cuid())
  flagId    String
  companyId String

  /// Override value — takes precedence over flag's global enabled
  enabled Boolean

  /// Why this override exists
  reason  String?
  enabledBy String?

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flagId, companyId])
  @@index([flagId])
  @@index([companyId])
}

// ── Secrets ───────────────────────────────────────────────────────────────

enum RuntimeSecretProvider {
  ENVIRONMENT
  VAULT
  AWS_SECRETS
  AZURE_KEYVAULT
  GCP_SECRET_MANAGER
}

enum RuntimeSecretCategory {
  DATABASE
  API_KEY
  ENCRYPTION_KEY
  OAUTH_TOKEN
  WEBHOOK_SECRET
  CERTIFICATE
  SERVICE_ACCOUNT
  LICENSE_KEY
  OTHER
}

enum RuntimeSecretStatus {
  ACTIVE
  ROTATING
  DEPRECATED
  DELETED
}

model RuntimeSecretMetadata {
  id        String  @id @default(cuid())
  companyId String?

  /// Human-readable name (e.g., "plaid-client-id")
  name     String
  category RuntimeSecretCategory @default(API_KEY)

  /// Which provider holds the actual value
  provider RuntimeSecretProvider @default(ENVIRONMENT)

  /// Provider-specific key/path (e.g., env var name, Vault path)
  providerKey String

  /// Current version number
  version Int @default(1)

  /// Rotation policy
  rotationIntervalDays Int?   // null = never auto-rotate
  nextRotationAt       DateTime?

  /// Expiration
  expiresAt DateTime?

  /// Ownership
  createdBy   String?
  ownerTeam   String?
  ownerUserId String?

  /// Status
  status RuntimeSecretStatus @default(ACTIVE)

  /// Audit metadata (last accessed, last rotated)
  lastAccessedAt DateTime?
  lastAccessedBy String?
  lastRotatedAt  DateTime?
  lastRotatedBy  String?

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([name])
  @@index([provider])
  @@index([status])
  @@index([nextRotationAt]) // for rotation scheduler polling
}

model RuntimeSecretVersion {
  id       String @id @default(cuid())
  secretId String

  /// Version number (monotonically increasing)
  version Int

  /// Hash of the secret value (not the value itself)
  valueHash String

  /// Who rotated it and why
  rotatedBy String?
  rotatedAt DateTime @default(now())
  reason    String?

  /// Provider metadata (e.g., Vault version, AWS version)
  providerMetadata Json?

  @@unique([secretId, version])
  @@index([secretId])
  @@index([rotatedAt])
}

